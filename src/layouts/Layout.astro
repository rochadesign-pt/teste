---
import "@/styles/index.css";
import { ClientRouter } from "astro:transitions";

import { Footer } from "@/components/layout/Footer";
import { Navbar } from "@/components/layout/Navbar";
import { Cursor } from "@/components/motion/Cursor";
import { Grain } from "@/components/motion/Grain";
import { SmoothScroll } from "@/components/motion/SmoothScroll";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='15' fill='%235c0e1e'/%3E%3Ccircle cx='16' cy='16' r='15' fill='none' stroke='%23ffc72c' stroke-width='2'/%3E%3Cpath d='M1 16h30M16 1v30M4 6c6 6 6 14 0 20M28 6c-6 6-6 14 0 20' stroke='%23ffc72c' stroke-width='1.6' fill='none'/%3E%3C/svg%3E"
    />
    <ClientRouter />
  </head>
  <body>
    <SmoothScroll client:load transition:persist="smooth-scroll" />
    <Cursor client:load transition:persist="cursor" />
    <Grain />
    <Navbar client:load currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer client:visible />

    <!-- Cortina de transição entre páginas (persistente entre swaps) -->
    <div
      id="page-curtain"
      transition:persist="curtain"
      class="pointer-events-none fixed inset-0 z-[90] origin-bottom scale-y-0 bg-bordeaux-950"
      aria-hidden="true"
    >
    </div>

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      const reduced = () =>
        window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const curtain = () => document.getElementById("page-curtain");

      // Cobrir o ecrã (de baixo para cima) antes de trocar de página.
      document.addEventListener("astro:before-preparation", (ev) => {
        if (reduced()) return;
        const originalLoader = ev.loader;
        ev.loader = async function () {
          await gsap
            .fromTo(
              curtain(),
              { scaleY: 0, transformOrigin: "bottom" },
              { scaleY: 1, duration: 0.45, ease: "power4.inOut" },
            )
            .then(() => {});
          await originalLoader();
        };
      });

      // Descobrir (a subir) quando a página nova está pronta.
      document.addEventListener("astro:page-load", () => {
        const el = curtain();
        if (!el) return;
        if (reduced()) {
          gsap.set(el, { scaleY: 0 });
          return;
        }
        if (Number(gsap.getProperty(el, "scaleY")) > 0.5) {
          gsap.to(el, {
            scaleY: 0,
            transformOrigin: "top",
            duration: 0.7,
            ease: "power4.inOut",
            delay: 0.1,
          });
        }
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
